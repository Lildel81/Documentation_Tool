<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="mb-1">
                Supplemental Reports
            </h2>

            <p class="text-muted mb-0">
                Saved supplemental case narratives
            </p>

        </div>


        <a
            href="/supplemental-report"
            class="btn btn-primary"
        >
            + New Supplemental Report
        </a>

    </div>


    <div class="card shadow">

        <div class="card-body">

            <% if (reports.length === 0) { %>

                <p class="text-muted mb-0">
                    No supplemental reports have been created.
                </p>

            <% } else { %>

                <div class="table-responsive">

                    <table
                        class="table table-hover align-middle"
                    >

                        <thead>

                            <tr>

                                <th>
                                    Case Number
                                </th>

                                <th>
                                    Report Title
                                </th>

                                <th>
                                    Report Date
                                </th>

                                <th>
                                    Created
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% reports.forEach(report => { %>

                                <tr>

                                    <td>
                                        <strong>
                                            <%= report.caseNumber %>
                                        </strong>
                                    </td>

                                    <td>
                                        <%= report.reportTitle %>
                                    </td>

                                    <td>
                                        <%= report.reportDate %>
                                    </td>

                                    <td>
                                        <%= report.createdAt
                                            ? report.createdAt.toLocaleString()
                                            : ''
                                        %>
                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </div>

</div>