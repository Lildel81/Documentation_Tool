<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="mb-1">Forensic Records</h1>

            <p class="text-muted mb-0">
                Investigative documentation awaiting migration to Kaseware
            </p>
        </div>

        <a href="/" class="btn btn-primary">
            + New Documentation
        </a>

    </div>


    <!-- Records Card -->
    <div class="card shadow-lg">

        <div class="card-body p-4">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Received</th>
                            <th>Hours</th>
                            <th>Report</th>
                            <th>Provided</th>
                            <th>Kaseware</th>
                            <th></th>
                        </tr>

                    </thead>


                    <tbody>

                        <% if (records.length === 0) { %>

                            <tr>

                                <td
                                    colspan="8"
                                    class="text-center py-5 text-muted"
                                >
                                    No forensic records have been created yet.
                                </td>

                            </tr>

                        <% } %>


                        <% records.forEach(record => { %>

                            <tr
                                class="record-row"

                                data-title="<%= record.title || '' %>"

                                data-agency="<%= record.requestingAgency || '' %>"

                                data-type="<%= record.typeOfInvestigation || '' %>"

                                data-report="<%= record.reportComplete || '' %>"

                                data-migration="<%= record.migratedToKaseware ? 'migrated' : 'pending' %>"
                            >

                                <!-- Title -->
                                <td>
                                    <strong>
                                        <%= record.title %>
                                    </strong>
                                </td>


                                <!-- Investigation Type -->
                                <td>
                                    <%= record.typeOfInvestigation %>
                                </td>


                                <!-- Request Received -->
                                <td>
                                    <%= record.requestReceived %>
                                </td>


                                <!-- Hours -->
                                <td>
                                    <%= record.hoursSpent %>
                                </td>


                                <!-- Report Complete -->
                                <td>

                                    <% if (record.reportComplete === 'Yes') { %>

                                        <span class="badge bg-success">
                                            Complete
                                        </span>

                                    <% } else { %>

                                        <span class="badge bg-warning text-dark">
                                            Incomplete
                                        </span>

                                    <% } %>

                                </td>


                                <!-- Provided -->
                                <td>

                                    <% if (record.providedToInvestigator === 'Yes') { %>

                                        <span class="badge bg-success">
                                            Yes
                                        </span>

                                    <% } else { %>

                                        <span class="badge bg-secondary">
                                            No
                                        </span>

                                    <% } %>

                                </td>


                                <!-- Kaseware Migration -->
                                <td>

                                    <% if (record.migratedToKaseware) { %>

                                        <span class="badge bg-success">
                                            Migrated
                                        </span>

                                    <% } else { %>

                                        <span class="badge bg-info">
                                            Pending
                                        </span>

                                    <% } %>

                                </td>


                                <!-- Actions -->
                                <td class="text-end">

                                    <a
                                        href="/records/<%= record._id %>"
                                        class="btn btn-sm btn-outline-light"
                                    >
                                        View
                                    </a>

                                </td>

                            </tr>

                        <% }); %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<!-- Search and Filters -->
<div class="card mb-4">

    <div class="card-body">

        <div class="row g-3">

            <!-- Search -->
            <div class="col-lg-4">

                <label
                    for="recordSearch"
                    class="form-label"
                >
                    Search Records
                </label>

                <input
                    type="text"
                    class="form-control"
                    id="recordSearch"
                    placeholder="Search title, agency, type..."
                >

            </div>


            <!-- Kaseware Status -->
            <div class="col-lg-2">

                <label
                    for="migrationFilter"
                    class="form-label"
                >
                    Kaseware
                </label>

                <select
                    class="form-select"
                    id="migrationFilter"
                >

                    <option value="all">
                        All
                    </option>

                    <option value="pending">
                        Pending
                    </option>

                    <option value="migrated">
                        Migrated
                    </option>

                </select>

            </div>


            <!-- Investigation Type -->
            <div class="col-lg-2">

                <label
                    for="typeFilter"
                    class="form-label"
                >
                    Investigation Type
                </label>

                <select
                    class="form-select"
                    id="typeFilter"
                >

                    <option value="all">
                        All
                    </option>

                    <option value="Crypto">
                        Crypto
                    </option>

                    <option value="FinCEN">
                        FinCEN
                    </option>

                    <option value="OSINT">
                        OSINT
                    </option>

                    <option value="IP Tracking">
                        IP Tracking
                    </option>

                    <option value="Fraud">
                        Fraud
                    </option>

                    <option value="Data Breach">
                        Data Breach
                    </option>

                    <option value="Social Media">
                        Social Media
                    </option>

                    <option value="Dark Web">
                        Dark Web
                    </option>

                </select>

            </div>


            <!-- Report Status -->
            <div class="col-lg-2">

                <label
                    for="reportFilter"
                    class="form-label"
                >
                    Report
                </label>

                <select
                    class="form-select"
                    id="reportFilter"
                >

                    <option value="all">
                        All
                    </option>

                    <option value="Yes">
                        Complete
                    </option>

                    <option value="No">
                        Incomplete
                    </option>

                </select>

            </div>


            <!-- Reset -->
            <div class="col-lg-2 d-flex align-items-end">

                <button
                    type="button"
                    class="btn btn-outline-light w-100"
                    id="clearFilters"
                >
                    Clear Filters
                </button>

            </div>

        </div>

    </div>

</div>

<script src="/js/records.js"></script>